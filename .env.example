# Copy this file to .env (which is gitignored) and fill in your key:
#   cp .env.example .env
# NEVER commit .env or paste your key anywhere else.
ANTHROPIC_API_KEY=
# Optional: which model the LLM controllers use (default: claude-haiku-4-5-20251001)
SCALE_MODEL=

# Optional: run the LLM controllers through OpenRouter instead (--provider openrouter)
OPENROUTER_API_KEY=
# Required with --provider openrouter unless you pass --model, e.g. meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=
# Optional: pin the upstream provider(s) so runs are reproducible, e.g. Fireworks
OPENROUTER_UPSTREAM=
